{
    "name":  "LastLight",
    "author":  "Zyared",
    "description":  "Black and violet circuit frames, a gold lamp with an orange glow and a neon city behind the library. An unofficial theme with original artwork.",
    "version":  "1.1.0",
    "header_image":  "assets/logo.svg",
    "splash_image":  "assets/logo.svg",
    "tags":  [
                 "dark",
                 "neon",
                 "retro"
             ],
    "Steam-WebKit":  "webkit.css",
    "Patches":  [
                    {
                        "MatchRegexString":  "^Steam$",
                        "TargetCss":  "libraryroot.custom.css",
                        "TargetJs":  "libraryroot.custom.js"
                    },
                    {
                        "MatchRegexString":  "^(Войти в Steam|Sign in to Steam)$",
                        "TargetCss":  "login.custom.css"
                    },
                    {
                        "MatchRegexString":  "^notificationtoasts",
                        "TargetCss":  "toast.custom.css"
                    },
                    {
                        "MatchRegexString":  ".DesktopToastPopup",
                        "TargetCss":  "toast.custom.css"
                    },
                    {
                        "MatchRegexString":  "(Menu|Supernav)$",
                        "TargetCss":  "libraryroot.custom.css"
                    },
                    {
                        "MatchRegexString":  ".ModalDialogPopup",
                        "TargetCss":  "libraryroot.custom.css"
                    },
                    {
                        "MatchRegexString":  ".FullModalOverlay",
                        "TargetCss":  "libraryroot.custom.css"
                    },
                    {
                        "MatchRegexString":  ".friendsui-container",
                        "TargetCss":  "friends.custom.css"
                    }
                ],
    "Conditions":  {
                       "Color scheme":  {
                                            "default":  "Violet night",
                                            "description":  "Main colours of the whole theme. Restart Steam after changing it.",
                                            "values":  {
                                                           "Violet night":  {

                                                                            },
                                                           "Pink city":  {
                                                                             "TargetCss":  {
                                                                                               "affects":  [
                                                                                                               ".*"
                                                                                                           ],
                                                                                               "src":  "opt/scheme-pink.css"
                                                                                           }
                                                                         },
                                                           "Emerald":  {
                                                                           "TargetCss":  {
                                                                                             "affects":  [
                                                                                                             ".*"
                                                                                                         ],
                                                                                             "src":  "opt/scheme-emerald.css"
                                                                                         }
                                                                       },
                                                           "Deep blue":  {
                                                                             "TargetCss":  {
                                                                                               "affects":  [
                                                                                                               ".*"
                                                                                                           ],
                                                                                               "src":  "opt/scheme-blue.css"
                                                                                           }
                                                                         }
                                                       }
                                        },
                       "Character":  {
                                         "default":  "Traveller",
                                         "description":  "Figure in the corner. My image uses assets/character.png in the theme folder. Restart Steam after changing it.",
                                         "values":  {
                                                        "Traveller":  {

                                                                      },
                                                        "My image":  {
                                                                         "TargetCss":  {
                                                                                           "affects":  [
                                                                                                           ".*"
                                                                                                       ],
                                                                                           "src":  "opt/character-custom.css"
                                                                                       }
                                                                     },
                                                        "None":  {
                                                                     "TargetCss":  {
                                                                                       "affects":  [
                                                                                                       ".*"
                                                                                                   ],
                                                                                       "src":  "opt/character-none.css"
                                                                                   }
                                                                 }
                                                    }
                                     },
                       "Start screen":  {
                                            "default":  "yes",
                                            "description":  "The lamp coming on when Steam starts.",
                                            "values":  {
                                                           "yes":  {

                                                                   },
                                                           "no":  {
                                                                      "TargetCss":  {
                                                                                        "affects":  [
                                                                                                        "^Steam$"
                                                                                                    ],
                                                                                        "src":  "opt/no-boot.css"
                                                                                    }
                                                                  }
                                                       }
                                        },
                       "HUD readout":  {
                                           "default":  "yes",
                                           "description":  "Clock and status line in the bottom bar.",
                                           "values":  {
                                                          "yes":  {

                                                                  },
                                                          "no":  {
                                                                     "TargetCss":  {
                                                                                       "affects":  [
                                                                                                       "^Steam$"
                                                                                                   ],
                                                                                       "src":  "opt/no-hud.css"
                                                                                   }
                                                                 }
                                                      }
                                       },
                       "Scanlines":  {
                                         "default":  "yes",
                                         "description":  "Faint CRT scanlines over the client.",
                                         "values":  {
                                                        "yes":  {

                                                                },
                                                        "no":  {
                                                                   "TargetCss":  {
                                                                                     "affects":  [
                                                                                                     "^Steam$"
                                                                                                 ],
                                                                                     "src":  "opt/no-scan.css"
                                                                                 }
                                                               }
                                                    }
                                     }
                   }
}
